# ====================================================================
# REQUIRED CONFIGURATION
# ====================================================================

# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# MongoDB Connection URI (e.g. from MongoDB Atlas: https://cloud.mongodb.com)
MONGO_DB=mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Owner User ID(s) separated by space (get via @userinfobot or @missrose_bot)
OWNER_ID=123456789

# Channel ID for forced subscription (must start with -100)
FORCE_SUB=-1001234567890

# Log Channel/Group ID (must start with -100)
LOG_GROUP=-1001234567890

# ====================================================================
# OPTIONAL CONFIGURATION
# ====================================================================

# Database name
DB_NAME=telegram_downloader

# Optional Telegram Premium user session string for 4GB upload support
STRING=

# Encryption keys for session management
MASTER_KEY=gK8HzLfT9QpViJcYeB5wRa3DmN7P2xUq
IV_KEY=s7Yx5CpVmE3F

# Usage Limits
FREEMIUM_LIMIT=0
PREMIUM_LIMIT=500

# UI Links
JOIN_LINK=https://t.me/team_spy_pro
ADMIN_CONTACT=https://t.me/username_of_admin

# Cookies (Netscape format)
YT_COOKIES=
INSTA_COOKIES=
